apiVersion: v1
kind: Secret
metadata:
  name: otto-complete-secrets
  namespace: otto-complete
type: Opaque
stringData:
  JIRA_API_TOKEN: "your-jira-api-token"
  JIRA_URL: "https://your-instance.atlassian.net"
  JIRA_USER: "you@example.com"
---
apiVersion: v1
kind: Secret
metadata:
  name: github-app-key
  namespace: otto-complete
type: Opaque
stringData:
  private-key.pem: |
    -----BEGIN RSA PRIVATE KEY-----
    your-github-app-private-key-here
    -----END RSA PRIVATE KEY-----
---
apiVersion: v1
kind: Secret
metadata:
  name: gcp-sa-key
  namespace: otto-complete
type: Opaque
stringData:
  key.json: |
    {
      "type": "service_account",
      "project_id": "your-project-id",
      "private_key": "-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----\n",
      "client_email": "your-sa@your-project.iam.gserviceaccount.com"
    }
